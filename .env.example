# Configuracao do banco da nuvem iZCloud (NOSSO MySQL, modelo iDCloud)
IDCLOUD_HOST=localhost
IDCLOUD_PORT=3306
IDCLOUD_USER=root
IDCLOUD_PASS=senha_forte_aqui

# Banco "core" (contas de clientes / tenants)
CORE_DB=izcloud_core

# ---- Segredos: OBRIGATORIOS em producao ----
# Gere com: openssl rand -hex 32
# O app acusa no log se estiver vazio, curto (<32) ou igual a este exemplo.
JWT_SECRET=gere_um_segredo_forte
# Protege POST /api/auth/register, POST /api/auth/registro (com x-admin-key),
# GET /api/auth/clientes e GET /api/health/db.
IZCLOUD_ADMIN_KEY=chave_de_setup_inicial
# Administrador da PLATAFORMA (entra em /admin.html e cria as contas dos
# clientes). Criado automaticamente na 1a subida; se a conta ja existir, apenas
# e promovida a admin. Sem estas duas variaveis nao existe admin — use o
# IZCLOUD_ADMIN_KEY + curl (POST /api/auth/registro).
IZCLOUD_ADMIN_LOGIN=admin
IZCLOUD_ADMIN_SENHA=senha_forte_de_8_ou_mais
# Validade do token de login (padrao 12h)
JWT_TTL=12h

# ---- Politica de acesso ----
# Cadastro publico desligado: as contas sao criadas pelo administrador.
# true = qualquer visitante pode criar a propria conta (NAO use em producao).
IZCLOUD_SIGNUP_ABERTA=false
# Origens extras liberadas no CORS (a UI e servida na mesma origem; vazio = nenhuma)
IZCLOUD_ORIGENS=
# Limite de tentativas de login por IP (padrao 8 a cada 15 min)
IZCLOUD_LOGIN_MAX_TENTATIVAS=8
IZCLOUD_LOGIN_JANELA_MS=900000

# Porta da API do iZCloud
PORT=3100

# ---- Canal iDCloud (REP -> nuvem) ----
# Endereco em que o servidor TLS do canal escuta. NAO use IDCLOUD_HOST aqui:
# IDCLOUD_HOST e o MySQL. 0.0.0.0 = todas as interfaces.
IDCLOUD_BIND=0.0.0.0
# Porta do canal. O REP so conecta na 443; numa VPS use 443. Atras de um proxy
# TCP (ex.: relay fixo -> Railway TCP proxy) use a porta interna escolhida.
IDCLOUD_PORTA=443
# Certificado e chave do canal (autoassinado serve; o REP nao valida a CA).
# Sem os dois arquivos o canal nao sobe e a API continua normal.
IDCLOUD_CERT=
IDCLOUD_KEY=
# Alternativa ao arquivo: o PEM inteiro no env (Railway/container sem volume).
IDCLOUD_CERT_PEM=
IDCLOUD_KEY_PEM=
# Senha do web server do REP (admin). Se o equipamento tiver Passcode proprio,
# ele tem prioridade.
REP_ADMIN_SENHA=
# 0 = pede get_afd SEM `limit` (arquivo inteiro; validar no firmware real).
# >0 = limita a janela (maximo 1000 aceito pelo aparelho).
IDCLOUD_AFD_LIMIT=0
# URL publica do iZCloud (ex.: https://izcloud.com.br). Usada para montar a URL
# de push do iDFace. Vazio = usa o host/protocolo da requisicao.
IZCLOUD_PUBLIC_URL=
# Onde guardar o AFD bruto (iDClass/iDFace). Vazio = ./data/afd.
IZCLOUD_AFD_DIR=
# true = aceita automaticamente REP cujo serial ja esteja cadastrado. E o que
# permite a coleta sem reserva manual. false = exige reservar-coleta.
IDCLOUD_AUTOACEITE=true
# true = no primeiro contato de um REP, se a empresa ainda nao tem funcionarios,
# le empresa/funcionarios/biometria da memoria do REP (importacao inicial).
IDCLOUD_IMPORTAR_AUTOMATICO=true
